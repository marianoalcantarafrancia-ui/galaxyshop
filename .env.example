# ============================================================
#  GalaxyShop - variables de entorno
#  Copiar a .env :   cp .env.example .env
# ============================================================

# ---- Keycloak ----
KC_PORT=8081
KC_ADMIN=admin
KC_ADMIN_PASSWORD=Admin#2026

# ---- BD de Keycloak (persistente) ----
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_PORT=5433

# ---- BD de la aplicacion ----
APP_DB_NAME=galaxyshop
APP_DB_USER=galaxyshop
APP_DB_PASSWORD=galaxyshop
APP_DB_PORT=5434

# ---- Identity Providers externos (Rubrica #7) ----
# Registrar una OAuth App en https://github.com/settings/developers
# Callback: http://localhost:8081/realms/galaxyshop/broker/github/endpoint
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme

# Registrar credenciales OAuth en https://console.cloud.google.com/apis/credentials
# Callback: http://localhost:8081/realms/galaxyshop/broker/google/endpoint
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# ---- Zona horaria (afecta las Time Policies de Keycloak) ----
TZ=America/Lima
